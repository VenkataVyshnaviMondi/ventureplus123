NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://venture_user:change-me@localhost:3306/venture
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:8081,http://localhost:8082
REALTIME_TRANSPORT=sse
REALTIME_REDIS_URL=
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CSRF_COOKIE_NAME=estatehub_csrf
ACCESS_TOKEN_COOKIE_NAME=estatehub_access
LOG_LEVEL=info

# Optional staging-only TLS configuration (server environment, never VITE_*).
# Vercel supplies VERCEL_ENV=preview; all previews require the settings below.
# See TIDB-STAGING-TLS.md. Do not enable these for production or ordinary local development.
# TIDB_STAGING_DB_USER=2K37DPjU76qJR1z.vp_runtime
# TIDB_CA_CERT_BASE64=<base64 of the trusted CA PEM, supplied outside Git>
