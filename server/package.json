{
  "name": "estatehub-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "predev": "npm run prisma:generate",
    "build": "tsc -p tsconfig.json",
    "prebuild": "npm run prisma:generate",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test:auth": "npm run build && node --test tests/auth-contract.test.mjs tests/native-auth.test.mjs tests/logger-redaction.test.mjs",
    "test:security": "npm run build && node --test tests/data-authorization.test.mjs",
    "test:shared-data": "node tests/shared-data.integration.mjs",
    "test:integration-guards": "node --test tests/isolated-config.test.mjs",
    "prisma:generate": "prisma generate --schema ../database/schema.prisma && node ./scripts/sync-prisma-client.mjs",
    "prisma:migrate": "prisma migrate dev --schema ../database/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema ../database/schema.prisma",
    "prisma:studio": "prisma studio --schema ../database/schema.prisma",
    "seed": "node src/scripts/seed.mjs",
    "admin:provision": "node scripts/provision-admin.mjs",
    "data:migrate:mysql": "node scripts/migrate-mongo-to-mysql.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.16.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie": "^0.6.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.0.2",
    "multer": "^1.4.5-lts.1",
    "redis": "^4.7.0",
    "pino": "^9.5.0",
    "pino-http": "^9.0.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.16.5",
    "bson": "5.5.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "prisma": "^5.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "22.x"
  }
}
